#!/bin/bash
# setup-steam-config — probe monitors, enable Proton for all games, set gamescope launch option
# Run from a desktop session after Steam has been launched at least once.

set -euo pipefail

STEAM_DIR="$HOME/.steam/steam"
CONFIG_VDF="$STEAM_DIR/config/config.vdf"
LOCALCONFIG_VDF="$STEAM_DIR/userdata/$(ls "$STEAM_DIR/userdata/" 2>/dev/null | head -1)/config/localconfig.vdf"
OUTPUTS_ENV="$HOME/.config/kde-displays/outputs.env"
HYPRZZITE_ENV="$HOME/.config/hyprzzite/outputs.env"

mkdir -p "$(dirname "$OUTPUTS_ENV")" "$(dirname "$HYPRZZITE_ENV")"

# ── 1. Probe monitors ──────────────────────────────────────────────────────────
GAMING_HZ=144      # fallback
HDR_SUPPORTED=0
GAMING_OUTPUT=""   # output name used for gamescope --prefer-output

if command -v hyprctl &>/dev/null && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    # Running in Hyprland session
    MONITORS=$(hyprctl monitors -j 2>/dev/null || echo "[]")
    # Find the highest-refresh non-TV monitor (prefer AOC-class: 1440p @ >=120Hz)
    GAMING_HZ=$(echo "$MONITORS" | jq '[.[] | select(.height == 1440 or .refreshRate >= 120)] | max_by(.refreshRate) | .refreshRate | floor' 2>/dev/null || echo 144)
    GAMING_OUTPUT=$(echo "$MONITORS" | jq -r '[.[] | select(.height == 1440 or .refreshRate >= 120)] | max_by(.refreshRate) | .name' 2>/dev/null || echo "")
    # HDR probe via kscreen-doctor if available
    if command -v kscreen-doctor &>/dev/null; then
        kscreen-doctor -o 2>/dev/null | grep -qi "hdr" && HDR_SUPPORTED=1 || HDR_SUPPORTED=0
    fi
elif command -v kscreen-doctor &>/dev/null; then
    # Running in KDE session
    KSCREEN=$(kscreen-doctor -o 2>/dev/null || echo "")
    # Parse highest refresh rate (AOC 1440p@180 is our gaming monitor)
    GAMING_HZ=$(echo "$KSCREEN" | grep -oP '\d+x\d+@\K\d+' | sort -n | tail -1 || echo 144)
    GAMING_OUTPUT=$(echo "$KSCREEN" | grep -B5 "2560x1440" | grep "Output:" | awk '{print $2}' | head -1 || echo "DP-2")
    echo "$KSCREEN" | grep -qi "hdr" && HDR_SUPPORTED=1 || HDR_SUPPORTED=0
else
    # No compositor available — use known values for this machine
    GAMING_HZ=180
    GAMING_OUTPUT="DP-2"
    HDR_SUPPORTED=0
fi

# Clamp to a sane range
[ "$GAMING_HZ" -lt 60 ]  && GAMING_HZ=60
[ "$GAMING_HZ" -gt 360 ] && GAMING_HZ=360

# ── 2. Write outputs.env ───────────────────────────────────────────────────────
cat > "$OUTPUTS_ENV" << EOF
# Generated by setup-steam-config on $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Re-run: setup-steam-config
GAMING_HZ=$GAMING_HZ
HDR_SUPPORTED=$HDR_SUPPORTED
GAMING_OUTPUT=${GAMING_OUTPUT:-DP-2}

# Known monitor assignments for this machine (hardcoded)
AOC_OUTPUT=DP-2
HISENSE_OUTPUT=DP-1
DELL_OUTPUT=DP-4
EOF
cp "$OUTPUTS_ENV" "$HYPRZZITE_ENV"

# ── 3. Build gamescope launch option ──────────────────────────────────────────
HDR_FLAG=""
[ "$HDR_SUPPORTED" = "1" ] && HDR_FLAG=" --hdr-enabled"

LAUNCH_OPT="gamescope -f --force-grab-cursor --adaptive-sync -r ${GAMING_HZ}${HDR_FLAG} -- gamemoderun %command%"

# ── 4. Enable Steam Play (Proton) for all titles in config.vdf ────────────────
if [ ! -f "$CONFIG_VDF" ]; then
    notify-send -u normal "Steam Config" "config.vdf not found — launch Steam once first, then re-run setup-steam-config"
    exit 1
fi

python3 - "$CONFIG_VDF" << 'PYEOF'
import sys, pathlib, re

vdf_path = pathlib.Path(sys.argv[1])
data = vdf_path.read_text(encoding='utf-8', errors='replace')

# Backup
vdf_path.with_suffix('.vdf.bak').write_text(data)

changed = False

# Enable Steam Play for all non-Linux games
# Key lives under InstallConfigStore > Software > Valve > Steam
if '"EnableProtonForUnsupportedGames"\t\t"1"' not in data:
    # Find the Steam section header and inject after it
    pattern = r'("Valve"\s*\n\s*\{[^{]*?"Steam"\s*\n\s*\{)'
    def inject(m):
        return m.group(0) + '\n\t\t\t\t"EnableProtonForUnsupportedGames"\t\t"1"'
    new_data = re.sub(pattern, inject, data, count=1, flags=re.DOTALL)
    if new_data != data:
        data = new_data
        changed = True
        print("Enabled Steam Play for all non-Linux titles")
    else:
        print("Could not locate Steam VDF section — skipping Steam Play patch")

# Set global Proton version (CompatToolMapping appid 0 = all games)
compat_block = '"CompatToolMapping"\n\t\t\t\t{\n\t\t\t\t\t"0"\n\t\t\t\t\t{\n\t\t\t\t\t\t"name"\t\t"proton_experimental"\n\t\t\t\t\t\t"config"\t\t""\n\t\t\t\t\t\t"Priority"\t\t"250"\n\t\t\t\t\t}\n\t\t\t\t}'
if '"CompatToolMapping"' not in data:
    # Inject before the closing brace of the Steam section
    # Look for the EnableProtonForUnsupportedGames we just added or any known key
    data = data.replace(
        '"EnableProtonForUnsupportedGames"\t\t"1"',
        '"EnableProtonForUnsupportedGames"\t\t"1"\n\t\t\t\t' + compat_block
    )
    changed = True
    print("Set Proton Experimental as global compatibility tool")

if changed:
    vdf_path.write_text(data)
    print("config.vdf updated")
else:
    print("config.vdf already up to date")
PYEOF

# ── 5. Patch localconfig.vdf — set gamescope launch option for all installed games ──
if [ -f "$LOCALCONFIG_VDF" ]; then
python3 - "$LOCALCONFIG_VDF" "$LAUNCH_OPT" << 'PYEOF'
import sys, pathlib, re

vdf_path = pathlib.Path(sys.argv[1])
launch_opt = sys.argv[2]
data = vdf_path.read_text(encoding='utf-8', errors='replace')

# Backup
vdf_path.with_suffix('.vdf.bak').write_text(data)

# Find all apps that already have a LaunchOptions key and update them
# Apps without a LaunchOptions key are left alone (don't want to add for every app)
pattern = r'("LaunchOptions"\s*")([^"]*?)(")'
def replace_if_empty(m):
    current = m.group(2)
    # Only replace if currently empty (user hasn't set custom options)
    if current.strip() == '':
        return m.group(1) + launch_opt + m.group(3)
    return m.group(0)

new_data = re.sub(pattern, replace_if_empty, data)
count = new_data.count(launch_opt)
if new_data != data:
    vdf_path.write_text(new_data)
    print(f"Updated {count} game(s) with gamescope launch option")
else:
    print("No empty LaunchOptions found to update")
PYEOF
fi

# ── 6. Report ──────────────────────────────────────────────────────────────────
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo " Gamescope launch option (copy into Steam > Properties > Launch options)"
echo ""
echo "  $LAUNCH_OPT"
echo ""
echo " Gaming monitor: ${GAMING_OUTPUT:-DP-2}  Refresh: ${GAMING_HZ}Hz  HDR: ${HDR_SUPPORTED}"
echo "═══════════════════════════════════════════════════════════════"

notify-send -u normal "Steam Config" \
    "Proton enabled for all games.\nGaming @ ${GAMING_HZ}Hz${HDR_FLAG:+ + HDR}\n\nLaunch option set. Restart Steam to apply."
