#!/bin/bash
# All 3 monitors on — Hisense TV (DP-1) as primary, VRR on AOC still

kscreen-doctor \
    output.DP-1.enable \
    output.DP-1.mode.3840x2160@144 \
    output.DP-1.primary \
    output.DP-2.enable \
    output.DP-2.mode.2560x1440@180 \
    output.DP-2.vrrpolicy.2 \
    output.DP-4.enable \
    output.DP-4.mode.1920x1080@60

# Audio → Hisense HDMI
SINK=$(pactl list sinks short | grep -i "dp-1\|hdmi" | awk '{print $2}' | head -1)
[ -n "$SINK" ] && pactl set-default-sink "$SINK"

# CEC: wake TV and set as active source
echo "on 0" | cec-client -s -d 1 2>/dev/null &
sleep 2 && echo "as" | cec-client -s -d 1 2>/dev/null &

notify-send "Display Mode" "TV Desk — Hisense primary (144Hz)"
