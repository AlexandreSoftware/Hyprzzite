# ─────────────────────────────────────────────────────────────────────────────
# dunstrc — Breeze Dark theme
# ─────────────────────────────────────────────────────────────────────────────

[global]
    monitor          = 0
    follow           = keyboard

    width            = 320
    height           = 120
    origin           = top-right
    offset           = 12x12
    scale            = 0
    notification_limit = 5

    progress_bar             = true
    progress_bar_height      = 6
    progress_bar_frame_width = 1
    progress_bar_min_width   = 150
    progress_bar_max_width   = 280
    progress_bar_corner_radius = 3

    indicate_hidden    = yes
    transparency       = 5
    separator_height   = 1
    padding            = 12
    horizontal_padding = 14
    text_icon_padding  = 10
    frame_width        = 1
    frame_color        = "#3daee9"
    separator_color    = frame
    sort               = yes

    font         = JetBrainsMono Nerd Font 11
    line_height  = 0
    markup       = full
    format       = "<b>%s</b>\n%b"
    alignment    = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap    = yes
    ellipsize    = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position  = left
    min_icon_size  = 0
    max_icon_size  = 32
    icon_path      = /usr/share/icons/Papirus-Dark/16x16/status/:/usr/share/icons/Papirus-Dark/16x16/devices/:/usr/share/icons/Papirus-Dark/16x16/apps/

    sticky_history  = yes
    history_length  = 20

    dmenu  = /usr/bin/wofi -p dunst --dmenu
    browser = xdg-open

    always_run_script = true
    title  = Dunst
    class  = Dunst

    corner_radius    = 8
    ignore_dbusclose = false

    force_xwayland  = false
    force_xinerama  = false

    mouse_left_click   = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click  = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background  = "#1b2027"
    foreground  = "#7f8c8d"
    frame_color = "#24272c"
    timeout     = 4

[urgency_normal]
    background  = "#24272c"
    foreground  = "#eff0f1"
    frame_color = "#3daee9"
    timeout     = 6

[urgency_critical]
    background  = "#24272c"
    foreground  = "#eff0f1"
    frame_color = "#da4453"
    timeout     = 0
