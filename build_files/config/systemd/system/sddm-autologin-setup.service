[Unit]
Description=Configure SDDM autologin user
Before=sddm.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -c '\
  USER=$(getent passwd | awk -F: '"'"'$3 >= 1000 && $3 < 65534 {print $1; exit}'"'"'); \
  [ -n "$USER" ] && sed -i "s/^User=.*/User=$USER/" /etc/sddm.conf.d/zz-steamos-autologin.conf'

[Install]
WantedBy=multi-user.target
